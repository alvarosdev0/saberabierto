{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["full-page-screenshot"]
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.70 }],
        "categories:accessibility": ["warn", { "minScore": 0.80 }],
        "categories:best-practices": ["warn", { "minScore": 0.80 }],
        "categories:pwa": ["error", { "minScore": 0.90 }],
        "installable-manifest": "error",
        "splash-screen": "warn",
        "themed-omnibox": "warn",
        "content-width": "warn",
        "viewport": "warn",
        "service-worker": "error",
        "works-offline": "error",
        "offline-start-url": "error",
        "is-on-https": "warn",
        "redirects-http": "warn",
        "maskable-icon": "warn",
        "apple-touch-icon": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
